{% macro Settings(theme) %}
<section class="rg-card">
    <div class="rg-card__header">
        <div class="rg-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
        </div>
        <div>
            <h2 class="rg-card__title">Settings</h2>
            <p class="rg-card__desc">Application preferences</p>
        </div>
    </div>
    <div class="rg-card__body">
        <div class="rg-feature">
            <div class="rg-feature__info">
                <h3 class="rg-feature__name">Version</h3>
                <p class="rg-feature__desc">REGIX Studio</p>
            </div>
            <span id="version" class="text-sm font-medium text-card-foreground">v1.0</span>
        </div>
        <div class="rg-feature">
            <div class="rg-feature__info">
                <h3 class="rg-feature__name">Port</h3>
                <p class="rg-feature__desc">Local server</p>
            </div>
            <span id="port" class="text-sm font-medium text-card-foreground">4070</span>
        </div>
        <div class="rg-feature">
            <div class="rg-feature__info">
                <h3 class="rg-feature__name">Theme</h3>
                <p class="rg-feature__desc">Toggle light / dark</p>
            </div>
            <button id="themeToggle" data-theme="{{ theme or 'dark' }}" class="rg-btn rg-btn--secondary">{{ 'Light' if theme == 'light' else 'Dark' }}</button>
        </div>
        <div class="rg-feature rg-feature--stack">
            <div class="rg-feature__info">
                <h3 class="rg-feature__name">Hotkeys</h3>
                <p class="rg-feature__desc">Global keyboard shortcuts — work even when the browser is not focused</p>
            </div>
            <div id="hotkeyList" class="mt-4 w-full space-y-3"></div>
            <div class="mt-4 flex w-full gap-3">
                <button id="hotkeySave" class="rg-btn rg-btn--secondary w-full">Save Hotkeys</button>
                <button id="hotkeyReset" class="rg-btn rg-btn--secondary w-full">Reset to Defaults</button>
            </div>
        </div>
    </div>
</section>
{% endmacro %}